# Udyam Digital — Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://udyam:udyam_secret@localhost:5432/udyam_digital

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload
UPLOAD_DIR=../uploads/kyc
MAX_FILE_SIZE_MB=10

# AI Provider (optional - leave blank for deterministic fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# OCR - set path to Tesseract executable if not in PATH
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Application
APP_ENV=development
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dataset reference date (DO NOT CHANGE - hackathon spec)
DATASET_REFERENCE_DATE=2026-07-15
